# StockSense AI - Frontend Environment Variables
# Copy to .env.local for local development

# Backend API URL - set this to your deployed backend URL for production
# For local development, leave as-is (defaults to localhost:8000 in the code)
VITE_API_URL=http://localhost:8000

# For production (Render/Railway), set this to your deployed backend URL:
# VITE_API_URL=https://your-stocksense-backend.onrender.com
